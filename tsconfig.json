{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    // The Durable Object and the Worker compile against workers-types; the tests and the bun:sqlite
    // test adapter need @types/bun. Same pairing as worker/tsconfig.json.
    "types": ["@cloudflare/workers-types", "@types/bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
